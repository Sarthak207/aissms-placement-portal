NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aissms-placement

# JWT secrets - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_20_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_MS=604800000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (leave blank in local dev - emails will be logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AISSMS Placement Cell <no-reply@aissms.edu>

# Frontend origin (for CORS + email links)
CLIENT_URL=http://localhost:5173
